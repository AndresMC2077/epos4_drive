<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>epos4_drive</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble C++ Node for Maxon EPOS4 Torque Control in CST mode with position feedback</description>
  <maintainer email="asphodell@todo.todo">asphodell</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>eposlib</depend>
  <depend>ros2units</depend>
  <depend>lely_core_libraries</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

